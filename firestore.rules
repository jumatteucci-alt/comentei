rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sites: só o dono lê e escreve
    match /sites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Comments: leitura pública, escrita só via API (admin SDK)
    match /comments/{commentId} {
      allow read: if true;
      allow write: if false; // apenas o admin SDK via API route
    }
  }
}
